{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase/**",
      "functions/**",
      "tests/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/.firebase/**",
      "**/.DS_Store"
    ],
    "rewrites": [
      { "source": "/sitemap.xml", "function": "sitemap" },
      { "source": "/jobs/:id", "function": "renderJob" },
      { "source": "/articles/:id", "function": "renderArticle" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "ui": { "enabled": true }
  }
}
