rules_version = '2';

// FIX (bug): same problem as firestore.rules — firebase.json has always
// pointed "storage.rules" at this exact path, but the file didn't exist,
// so `firebase deploy --only storage` would fail immediately.
//
// Matches the app's actual Storage usage: the shared file library uploads
// to files/{uid}/{timestamp}_{filename} (see the fileUploadInput handler
// in index.html), max 50MB, any signed-in member can download, only the
// uploader can delete.

service firebase.storage {
  match /b/{bucket}/o {
    match /files/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
