rules_version = '2';

// FIX (bug): firebase.json has always pointed "firestore.rules" at this
// exact path, but no such file was ever included in the delivered project.
// Without it, `firebase deploy --only firestore:rules` fails immediately
// with a "file not found" error, and a fresh Firestore database defaults
// to fully-locked (all reads/writes denied) — so the app wouldn't work at
// all until rules were written. These rules are modeled directly off the
// actual read/write calls in index.html (see grep of collection(db, ...)).
//
// Review before deploying to production — this is a solid, tested-shape
// starting point, not a substitute for your own security review.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isMe(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && myProfile().isAdmin == true; }
    // Only the listed fields changed between old/new doc versions.
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      // A user can edit their own profile. Other signed-in users may only
      // touch their own "blocked" list on someone ELSE's doc — but blocking
      // is actually stored on the blocker's own profile in this app
      // (users/{me}.blocked), so no cross-user write is needed here.
      allow update: if isMe(uid) || isAdmin();
      allow delete: if false;

      // FEATURE: saved/bookmarked jobs, articles, and posts — fully
      // private to the owner.
      match /saved/{itemId} {
        allow read, write: if isMe(uid);
      }
    }

    // ---- posts (feed) ----
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      // owner can edit their post; anyone signed in may toggle only the
      // "likes" array (like/unlike) or vote in a poll ("pollOptions");
      // admin can moderate (e.g. remove) any post.
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        onlyChanged(['likes']) ||
        onlyChanged(['pollOptions']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ---- jobs ----
    match /jobs/{jobId} {
      allow read: if true; // public — these are server-rendered for SEO too
      allow create: if isSignedIn() && request.resource.data.postedByUid == request.auth.uid;
      // poster/admin can edit or delete the job; ANY signed-in applicant
      // may bump only "applicantCount" as part of applying (see
      // submitJobApplication in index.html) — the applicant doc itself,
      // below, is what actually authorizes that they applied.
      allow update: if isSignedIn() && (
        resource.data.postedByUid == request.auth.uid || isAdmin() || onlyChanged(['applicantCount'])
      );
      allow delete: if isSignedIn() && (resource.data.postedByUid == request.auth.uid || isAdmin());

      // FEATURE: job applications — the applicant can create/read their own
      // application; the job poster (and admin) can read every applicant
      // for their own job posting to review candidates.
      match /applicants/{applicantUid} {
        allow create: if isSignedIn() && applicantUid == request.auth.uid && request.resource.data.applicantUid == request.auth.uid;
        allow read: if isSignedIn() && (
          applicantUid == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(jobId)).data.postedByUid == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if false; // applications are immutable once submitted
      }
    }

    // ---- articles ----
    match /articles/{articleId} {
      allow read: if true; // public — server-rendered for SEO too
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ---- connections (member-to-member links) ----
    match /connections/{connId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.members;
    }

    // ---- conversations + messages ----
    match /conversations/{convoId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      // members can update shared fields (lastMessage, unreadCounts.*,
      // typing.*, lastRead.*, mutedBy) as part of normal chat use.
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.memberIds;
        allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.memberIds;
        // FEATURE support: the sender can edit/delete-for-everyone their own
        // text; ANY conversation member may toggle their own reaction, star,
        // or "delete for me" entry without touching anyone else's fields.
        allow update: if isSignedIn() && (
          (resource.data.senderUid == request.auth.uid && onlyChanged(['text','edited','editedAt','deleted','imageURL','replyTo','reactions'])) ||
          onlyChanged(['reactions']) ||
          onlyChanged(['starredBy']) ||
          onlyChanged(['deletedFor'])
        ) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.memberIds;
        allow delete: if false; // use deletedFor / deleted:true instead of hard delete
      }
    }

    // ---- calls (WebRTC signaling + history) ----
    // Covers both 1:1 calls (callerUid/calleeUid) and group calls
    // (isGroup:true, memberIds, participantUids, initiatorUid) — see the
    // GROUP CALLING section in index.html for the data model.
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid ||
        (resource.data.isGroup == true && request.auth.uid in resource.data.memberIds)
      );
      allow create: if isSignedIn() && (
        request.resource.data.callerUid == request.auth.uid ||
        (request.resource.data.isGroup == true && request.resource.data.initiatorUid == request.auth.uid
          && request.auth.uid in request.resource.data.memberIds)
      );
      allow update: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid ||
        (resource.data.isGroup == true && request.auth.uid in resource.data.memberIds)
      );
      allow delete: if false;

      // 1:1 signaling (existing "callerCandidates" / "calleeCandidates")
      match /{candidates}/{candId} {
        allow read, create: if isSignedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
        );
      }

      // FEATURE (group calling): mesh signaling — one "pairs/{loUid_hiUid}"
      // doc per pair of participants, each holding its own offer/answer,
      // plus two candidate subcollections (candA/candB) underneath it.
      match /pairs/{pairKey} {
        allow read: if isSignedIn() && (request.auth.uid == resource.data.loUid || request.auth.uid == resource.data.hiUid);
        allow create: if isSignedIn() && (request.auth.uid == request.resource.data.loUid || request.auth.uid == request.resource.data.hiUid);
        allow update: if isSignedIn() && (request.auth.uid == resource.data.loUid || request.auth.uid == resource.data.hiUid)
          && onlyChanged(['answer']);

        match /{candSet}/{candId} {
          allow read, create: if isSignedIn() && (
            get(/databases/$(database)/documents/calls/$(callId)/pairs/$(pairKey)).data.loUid == request.auth.uid ||
            get(/databases/$(database)/documents/calls/$(callId)/pairs/$(pairKey)).data.hiUid == request.auth.uid
          );
        }
      }
    }

    // ---- notifications ----
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- reports (moderation) ----
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedByUid == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // PRODUCTION: rate-limit counters written only by the rateLimitPosts /
    // rateLimitMessages / rateLimitComments Cloud Functions (Admin SDK,
    // which bypasses these rules entirely). No client should ever read or
    // write this collection directly.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
