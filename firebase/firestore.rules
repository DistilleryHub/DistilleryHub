rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.isAdmin == true) ||
        (request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isModerator() {
      return signedIn() && (
        (request.auth.token.role in ['admin', 'moderator']) ||
        isAdmin()
      );
    }

    function isActiveUser() {
      return signedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == false
      );
    }

    function isValidUrl(url) {
      return url is string && (url.matches('^https?://.*') || url == '');
    }

    // ===============================================================
    // Users Collection (Profile, Settings, Bookmarks & Blocking)
    // ===============================================================
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false);

      allow update: if (
        (isOwner(uid) || isAdmin()) &&
        (request.resource.data.isAdmin == resource.data.isAdmin || isAdmin()) &&
        (request.resource.data.isBanned == resource.data.isBanned || isAdmin()) &&
        (request.resource.data.isVerified == resource.data.isVerified || isAdmin())
      ) || (
        // Skill endorsements: any signed-in member can endorse another
        // member's skill — scoped so this can NEVER touch any other field.
        signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endorsements'])
      );

      allow delete: if isOwner(uid) || isAdmin();

      match /blockedUsers/{blockedUid} {
        allow read, write: if isOwner(uid);
      }

      match /bookmarks/{postId} {
        allow read, write: if isOwner(uid);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ===============================================================
    // Posts & Comments
    // ===============================================================
    match /posts/{postId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!('imageURL' in request.resource.data) || isValidUrl(request.resource.data.imageURL))
        && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 5))
        // Basic spam throttle: 15s between posts. Client batches a
        // users/{uid}.lastPostAt update with every post creation — see
        // submitPost() in index.html. NOTE: this only stops abuse coming
        // through the app itself; a client hitting the Firestore SDK
        // directly could skip the paired update. Firebase App Check is the
        // real fix for that class of abuse.
        && (
          !('lastPostAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPostAt + duration.value(15, 's')
        );

      allow delete: if signedIn()
        && (resource.data.authorUid == request.auth.uid || isModerator());

      allow update: if signedIn() && (
        (
          resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 5))
        )
        || isModerator()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isActiveUser()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid || isModerator());

        allow update: if signedIn() && (
          (
            resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
          )
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
        );
      }
    }

    // ===============================================================
    // Jobs & Articles
    // ===============================================================
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.postedByUid == request.auth.uid
        && (
          !('lastJobPostAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastJobPostAt + duration.value(30, 's')
        );
      allow update, delete: if signedIn()
        && (resource.data.postedByUid == request.auth.uid || isModerator());
    }

    // Saved keyword alerts — matched server-side (matchJobAlerts Cloud
    // Function) against newly posted jobs. Read is scoped to the owner only
    // via a query filter in the client; the Cloud Function itself uses the
    // Admin SDK and bypasses these rules to scan all alerts.
    match /jobAlerts/{alertId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid;
    }

    // Note: no "verified creator" gate here — the app has no verification
    // workflow yet, so requiring it would block every member from publishing.
    // Add isVerifiedCreator() back if/when a verification system is built.
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.authorUid == request.auth.uid
        && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 5));
      allow update, delete: if signedIn()
        && (resource.data.authorUid == request.auth.uid || isModerator());
    }

    // ===============================================================
    // Status (24h stories + permanent updates)
    // ===============================================================
    match /statuses/{statusId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.type in ['story', 'post']
        && (!('imageURL' in request.resource.data) || isValidUrl(request.resource.data.imageURL));
      allow update, delete: if signedIn()
        && (resource.data.postedByUid == request.auth.uid || isModerator());
    }

    // ===============================================================
    // Market (equipment / services listings)
    // ===============================================================
    match /market/{listingId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.listingType in ['equipment', 'service']
        && (!('imageURL' in request.resource.data) || isValidUrl(request.resource.data.imageURL));
      allow update, delete: if signedIn()
        && (resource.data.postedByUid == request.auth.uid || isModerator());
    }

    // ===============================================================
    // Videos (uploads + YouTube links)
    // ===============================================================
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.source in ['upload', 'youtube']
        && isValidUrl(request.resource.data.url);
      allow update, delete: if signedIn()
        && (resource.data.postedByUid == request.auth.uid || isModerator());
    }

    // ===============================================================
    // Files (Storage metadata index)
    // ===============================================================
    match /files/{fileId} {
      allow read: if signedIn();
      allow create: if isActiveUser()
        && request.resource.data.uploadedByUid == request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.uploadedByUid == request.auth.uid || isModerator());
    }

    // ===============================================================
    // Connections
    // ===============================================================
    match /connections/{connId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.status in ['pending', 'accepted', 'rejected', 'blocked'];
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ===============================================================
    // Notifications & Presence
    // ===============================================================
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isActiveUser()
        && request.resource.data.fromUid == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // ===============================================================
    // Reports
    // ===============================================================
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedByUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isModerator();
    }

    // ===============================================================
    // Conversations & Messages (Chat Engine)
    // ===============================================================
    match /conversations/{conversationId} {
      // resource is null when the doc doesn't exist yet (first-time chat) —
      // must allow that case or getDoc() on a brand-new conversationId
      // throws permission-denied instead of returning "not found".
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);

      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2;

      // Update rules:
      // 1. Group Admin can update any conversation settings/members
      // 2. Regular members can leave group (removing themselves from memberIds)
      // 3. Metadata updates (lastMessage, unreadCounts, typing indicator)
      allow update: if signedIn() && (
        (
          'adminIds' in resource.data &&
          request.auth.uid in resource.data.adminIds
        ) || (
          request.auth.uid in resource.data.memberIds &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTime', 'unreadCounts', 'typing']) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessageId']) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
              !(request.auth.uid in request.resource.data.memberIds)
            )
          )
        )
      );

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;

        allow create: if isActiveUser()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.createdAt == request.time
          && request.resource.data.messageType in ['text', 'image', 'audio', 'file']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (!('replyToId' in request.resource.data) || request.resource.data.replyToId is string)
          && (!('imageURL' in request.resource.data) || isValidUrl(request.resource.data.imageURL));

        allow update: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds && (
          (
            resource.data.senderUid == request.auth.uid &&
            request.resource.data.senderUid == resource.data.senderUid &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.messageType == resource.data.messageType &&
            request.resource.data.text is string &&
            request.resource.data.text.size() <= 2000
          )
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy', 'seen', 'isSeen']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']))
        );

        allow delete: if signedIn()
          && (resource.data.senderUid == request.auth.uid || isModerator());
      }
    }

    // ===============================================================
    // Calls (WebRTC signaling: offer/answer + ICE candidates)
    // 1-1 calls use callerUid/calleeUid. Group calls (isGroup:true) use a
    // denormalized groupMemberIds array (copied from the conversation at
    // call-room creation time) so rules don't need extra get() chains.
    // ===============================================================
    match /calls/{callId} {
      allow read: if signedIn() && (
        (resource.data.isGroup == true && request.auth.uid in resource.data.groupMemberIds)
        || (resource.data.isGroup != true && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid))
      );
      allow create: if isActiveUser() && request.resource.data.type in ['audio','video'] && (
        (request.resource.data.isGroup == true && request.auth.uid in request.resource.data.groupMemberIds)
        || (request.resource.data.isGroup != true && request.auth.uid == request.resource.data.callerUid && request.resource.data.status == 'ringing')
      );
      allow update: if signedIn() && (
        (resource.data.isGroup == true && request.auth.uid in resource.data.groupMemberIds)
        || (resource.data.isGroup != true
            && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid)
            && request.resource.data.status in ['ringing','accepted','rejected','ended','missed'])
      );
      allow delete: if signedIn() && (
        (resource.data.isGroup == true && request.auth.uid in resource.data.groupMemberIds)
        || (resource.data.isGroup != true && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid))
      );

      match /callerCandidates/{candId} {
        allow read: if signedIn() && request.auth.uid in [
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid,
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid
        ];
        allow create: if signedIn() && request.auth.uid ==
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid;
      }
      match /calleeCandidates/{candId} {
        allow read: if signedIn() && request.auth.uid in [
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid,
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid
        ];
        allow create: if signedIn() && request.auth.uid ==
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid;
      }

      // Group call room membership — each user manages only their own doc.
      match /participants/{uid} {
        allow read: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/calls/$(callId)).data.groupMemberIds;
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // Mesh signaling for each participant pair (offer/answer + candidates).
      match /pairs/{pairId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/calls/$(callId)).data.groupMemberIds;
        match /offererCandidates/{candId} {
          allow read, create: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/calls/$(callId)).data.groupMemberIds;
        }
        match /answererCandidates/{candId} {
          allow read, create: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/calls/$(callId)).data.groupMemberIds;
        }
      }
    }

    // ===============================================================
    // Catch-All Block
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
