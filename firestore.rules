rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    // True if either user has the other in their `blocked` array. Used to
    // stop a blocked user from messaging/calling — enforced here (not just
    // in the UI) since client-side checks alone can always be bypassed.
    function isBlockedPair(uidA, uidB) {
      let a = get(/databases/$(database)/documents/users/$(uidA)).data;
      let b = get(/databases/$(database)/documents/users/$(uidB)).data;
      return (('blocked' in a) && uidB in a.blocked) || (('blocked' in b) && uidA in b.blocked);
    }

    // ===== User secrets (MPIN hash, lockout state) =====
    // Never readable/writable by clients — only Cloud Functions (Admin SDK,
    // which bypasses these rules entirely) touch this collection. Keeping
    // an explicit `if false` here (instead of just omitting the match)
    // makes the intent unambiguous and fails closed if rules are refactored.
    match /userSecrets/{userId} {
      allow read, write: if false;
    }

    // ===== Users =====
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.blocked == resource.data.blocked
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== Posts (feed) =====
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount']) &&
          request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
            .union(resource.data.likes.toSet().difference(request.resource.data.likes.toSet()))
            == [request.auth.uid].toSet()));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
        allow update: if false;
      }
    }

    // ===== Status / stories =====
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

      match /views/{viewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===== Connections (network) =====
    match /connections/{connId} {
      allow read: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ===== Chats + messages =====
    // NOTE: "who can message me" (Settings > Privacy) is currently enforced
    // client-side only (Chat.jsx) — NOT here. Server-side enforcement needs
    // connections/{connId} to use a deterministic ID (e.g. sorted "uidA_uidB")
    // instead of addDoc's random ID, so a rule can get() a specific doc
    // instead of running a query (rules can't query). That's a data-model
    // change touching Network.jsx too, so it's left as a follow-up rather
    // than shipped half-verified. Block enforcement above IS server-side,
    // since `blocked` already lives at a fixed path (users/{uid}.blocked).
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants.size() != 2 ||
            !isBlockedPair(
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
            )
          );
        allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ===== Scheduled messages =====
    match /scheduledMessages/{msgId} {
      allow read, update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    // ===== Calls + signaling =====
    match /calls/{callId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants &&
        (
          request.resource.data.participants.size() != 2 ||
          !isBlockedPair(request.resource.data.participants[0], request.resource.data.participants[1])
        );
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /signals/{signalId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ===== Groups =====
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid || isGroupMember(groupId)) || isAdmin();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid || isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow delete: if isSignedIn() &&
          (request.auth.uid == memberId ||
           get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid);
        allow update: if false;
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
          allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
          allow update: if false;
        }
      }
    }

    // ===== Jobs / Articles / Courses / Videos / Files (read-open, owner-write) =====
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.postedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.postedBy == request.auth.uid || isAdmin();
    }
    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
    }
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
    }
    match /files/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uploadedBy == request.auth.uid || isAdmin();
    }

    // ===== Marketplace: listings + RFQs/bids =====
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid || isAdmin();
    }
    match /rfqs/{rfqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.buyerId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.buyerId == request.auth.uid || isAdmin();

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
        allow update: if isSignedIn() &&
          (resource.data.sellerId == request.auth.uid ||
           get(/databases/$(database)/documents/rfqs/$(rfqId)).data.buyerId == request.auth.uid);
        allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      }
    }

    // ===== Notifications (only the recipient can read/ack) =====
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    // ===== Presence (online / last seen) =====
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write, delete: if isOwner(userId);
    }

    // ===== Reports (users file, only admins read/manage) =====
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
