rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Checks the Auth custom claim, NOT the users/{uid}.isAdmin Firestore
    // field. The claim can only be set by the setAdminClaim Cloud Function
    // (Admin SDK) — see functions/index.js — so it can't be self-granted the
    // way a Firestore field theoretically could be if an update rule ever
    // slipped (exactly what happened with the `blocked` field below before
    // this fix). The Firestore field is kept in sync purely for display
    // (Admin.jsx's ADMIN badge) and must never be trusted for access control.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    // True if either user has the other in their `blocked` array. Used to
    // stop a blocked user from messaging/calling — enforced here (not just
    // in the UI) since client-side checks alone can always be bypassed.
    function isBlockedPair(uidA, uidB) {
      let a = get(/databases/$(database)/documents/users/$(uidA)).data;
      let b = get(/databases/$(database)/documents/users/$(uidB)).data;
      return (('blocked' in a) && uidB in a.blocked) || (('blocked' in b) && uidA in b.blocked);
    }

    // ===== Rate limiting =====
    // Used by messages/create, connections/create below. get() reads the
    // PRE-commit value (must already be stale enough) and getAfter() reads
    // the POST-commit value (must equal "now") — so a client can't create
    // the guarded doc without also correctly stamping its own rate-limit
    // doc in the very same batch, and can't pre-stamp early to "bank" a
    // future action either, since getAfter forces the stamp to equal this
    // commit's server timestamp exactly.
    match /rateLimits/{userId} {
      allow read: if false; // only rules read this, no client needs to
      allow write: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.lastMessageAt == request.time;
    }
    match /rateLimitsConnections/{userId} {
      allow read: if false;
      allow write: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.lastConnectionRequestAt == request.time;
    }
    // SECURITY FIX: notifications/{} and reports/{} below used to have no
    // rate limit at all — any signed-in user could spam another user with
    // unlimited fake notifications (each one also fires a real push via
    // onNotificationCreated) or flood the admin reports queue. Same
    // get()/getAfter() pattern as rateLimits/rateLimitsConnections above:
    // the client must stamp its own doc here, atomically, in the same
    // batch as the guarded write — it can't be skipped or pre-banked.
    match /rateLimitsNotifications/{userId} {
      allow read: if false;
      allow write: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.lastNotifAt == request.time;
    }
    match /rateLimitsReports/{userId} {
      allow read: if false;
      allow write: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.lastReportAt == request.time;
    }
    match /uploadRateLimits/{userId} {
      allow read, write: if false; // only getCloudinarySignature (Admin SDK) touches this
    }

    // ===== User secrets (MPIN hash, lockout state) =====
    // Never readable/writable by clients — only Cloud Functions (Admin SDK,
    // which bypasses these rules entirely) touch this collection.
    match /userSecrets/{userId} {
      allow read, write: if false;
    }

    // ===== Users =====
    match /users/{userId} {
      allow read: if isSignedIn();
      // SECURITY FIX: creation previously had no field restrictions at all,
      // so any signed-up user could write `isAdmin: true` straight into
      // their own brand-new doc via the client SDK (bypassing the signup
      // UI entirely — trivial with devtools). That flag could then be used
      // to self-promote via bootstrapAdminClaimFromLegacyFlag in
      // functions/index.js, which trusts this exact field. Now a new doc
      // must have isAdmin absent or explicitly false; only setAdminClaim
      // (Admin SDK, requires an existing admin's custom claim) can ever
      // set it true afterwards, via the update rule below.
      allow create: if isOwner(userId) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      // NOTE: this used to also require `blocked` to stay unchanged even
      // for the doc's own owner — that meant no user could ever actually
      // block anyone, since `blocked` lives on their own users/{uid} doc.
      // isAdmin stays locked down here too (belt-and-suspenders alongside
      // isAdmin() now checking the custom claim instead of this field);
      // blocked is freely owner-editable, matching Chat.jsx/Profile.jsx's
      // block buttons and the isBlockedPair() checks elsewhere here.
      allow update: if isAdmin() || (
        isOwner(userId) && request.resource.data.isAdmin == resource.data.isAdmin
      ) || (
        // Lets followUser()/unfollowUser() (follows.js) bump a *different*
        // user's followerCount by exactly +1/-1 in the same batch as the
        // follows/{followId} write — nothing else on the doc can move
        // through this branch. Falls back to 0 when the doc has never had
        // a followerCount field before (true for every user prior to their
        // first follower) — reading a missing map key directly would error
        // out this whole condition and silently deny the update.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) &&
        (request.resource.data.followerCount ==
           (('followerCount' in resource.data) ? resource.data.followerCount : 0) + 1 ||
         request.resource.data.followerCount ==
           (('followerCount' in resource.data) ? resource.data.followerCount : 0) - 1)
      );
      allow delete: if isAdmin();

      // Saved posts/jobs/articles — private to the owner only.
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===== Follows (one-way, LinkedIn-style "Follow" — separate from the
    // mutual accept/reject Connect flow above) =====
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followedId != request.auth.uid &&
        followId == (request.resource.data.followerId + '_' + request.resource.data.followedId);
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ===== Posts (feed) =====
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount']) &&
          request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
            .union(resource.data.likes.toSet().difference(request.resource.data.likes.toSet()))
            == [request.auth.uid].toSet()) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares']) &&
          request.resource.data.shares.toSet().difference(resource.data.shares.toSet())
            .union(resource.data.shares.toSet().difference(request.resource.data.shares.toSet()))
            == [request.auth.uid].toSet()));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
        allow update: if false;
      }
    }

    // ===== Status / stories =====
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Owner can update anything; anyone else viewing this status can only
      // add their own uid to viewedBy (StatusViewer.jsx's markViewed) —
      // same one-sided arrayUnion pattern as /videos likes, except viewedBy
      // only ever grows (no "un-view"), so it's a straight one-way diff
      // check rather than a symmetric union/difference like a toggleable
      // like. Without this, only the author could ever write viewedBy, so
      // every viewer's markViewed() silently failed permission-denied —
      // "seen by" stayed empty and the unseen ring never cleared.
      allow update: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin() ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']) &&
          request.resource.data.viewedBy.toSet().difference(resource.data.viewedBy.toSet()) == [request.auth.uid].toSet() &&
          resource.data.viewedBy.toSet().difference(request.resource.data.viewedBy.toSet()).size() == 0));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

      match /views/{viewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===== Connections (network) =====
    match /connections/{connId} {
      allow read: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid &&
        // 3s gap — connection requests are naturally rarer than messages,
        // so this is mainly an anti-spam-bot floor, not a normal-use limit.
        (
          !exists(/databases/$(database)/documents/rateLimitsConnections/$(request.auth.uid)) ||
          request.time > get(/databases/$(database)/documents/rateLimitsConnections/$(request.auth.uid)).data.lastConnectionRequestAt + duration.value(3, 's')
        ) &&
        getAfter(/databases/$(database)/documents/rateLimitsConnections/$(request.auth.uid)).data.lastConnectionRequestAt == request.time;
      allow update: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ===== Chats + messages =====
    // NOTE: "who can message me" (Settings > Privacy) is currently enforced
    // client-side only (Chat.jsx) — NOT here. Server-side enforcement needs
    // connections/{connId} to use a deterministic ID (e.g. sorted "uidA_uidB")
    // instead of addDoc's random ID, so a rule can get() a specific doc
    // instead of running a query (rules can't query). That's a data-model
    // change touching Network.jsx/Profile.jsx too, so it's left as a
    // follow-up rather than shipped half-verified. Block enforcement below
    // IS server-side, since `blocked` already lives at a fixed path
    // (users/{uid}.blocked).
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants.size() != 2 ||
            !isBlockedPair(
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
            )
          ) &&
          // Rate limit: at most ~1 message per 700ms per sender. Real
          // enforcement, not client-side-only — see rateLimits/{uid} above.
          (
            !exists(/databases/$(database)/documents/rateLimits/$(request.auth.uid)) ||
            request.time > get(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastMessageAt + duration.value(700, 'ms')
          ) &&
          getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastMessageAt == request.time;
        // Field-scoped on purpose: several message actions (reactions, read
        // receipts, delete-for-me, poll votes, "going" on an event, opening
        // a view-once) are performed by participants who did NOT send the
        // message, but they must never be able to touch its text/sender/etc.
        // A single blanket "sender can update anything" rule (the previous
        // version of this) actually blocked all of those non-sender actions
        // outright — reactions and read receipts would never have worked.
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (
            // Sender editing their own text (edit window mirrors the
            // client's EDIT_WINDOW_MS in Chat.jsx — keep both in sync).
            (
              resource.data.senderId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']) &&
              !('attachmentType' in resource.data) &&
              resource.data.createdAt is timestamp &&
              request.time < resource.data.createdAt + duration.value(15, 'm')
            ) ||
            // Sender deleting for everyone.
            (
              resource.data.senderId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mediaUrl', 'attachmentType', 'deletedForEveryone'])
            ) ||
            // Any participant: react / mark read / delete-for-self / vote / RSVP / open view-once.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'deletedFor', 'openedBy', 'poll', 'event'])
          );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ===== Scheduled messages (Chat) =====
    match /scheduledMessages/{msgId} {
      allow read, update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    // ===== Scheduled posts (Feed) =====
    match /scheduledPosts/{postId} {
      allow read, update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    // ===== Calls + signaling =====
    match /calls/{callId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants &&
        (
          request.resource.data.participants.size() != 2 ||
          !isBlockedPair(request.resource.data.participants[0], request.resource.data.participants[1])
        );
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /signals/{signalId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ===== Groups =====
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      // SECURITY FIX: this had no field restriction, so ANY group member
      // (not just the creator) could rewrite `createdBy` to their own uid
      // via a normal update call — then use that to kick the real creator
      // and every other member (members/{memberId} delete rule below
      // trusts groups/{groupId}.createdBy). Now createdBy can only be set
      // once, at creation, and can never change afterwards — matches how
      // users/{uid}.isAdmin is locked down above for the same reason.
      allow update: if isSignedIn() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (resource.data.createdBy == request.auth.uid || isGroupMember(groupId) || isAdmin());
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid || isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow delete: if isSignedIn() &&
          (request.auth.uid == memberId ||
           get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid);
        allow update: if false;
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
          allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
          allow update: if false;
        }
      }
    }

    // ===== Jobs / Articles / Courses / Videos / Files (read-open, owner-write) =====
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.postedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.postedBy == request.auth.uid || isAdmin();
    }
    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin() ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
            .union(resource.data.likes.toSet().difference(request.resource.data.likes.toSet()))
            == [request.auth.uid].toSet()) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
        allow update: if false;
      }
    }
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Owner can update anything; anyone else can only toggle their own
      // like (same uid-symmetric-difference check as /posts likes above)
      // or bump the denormalized commentCount when they add/remove a comment.
      allow update: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
            .union(resource.data.likes.toSet().difference(request.resource.data.likes.toSet()))
            == [request.auth.uid].toSet()) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid || isAdmin();
        allow update: if false;
      }
    }
    match /files/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uploadedBy == request.auth.uid || isAdmin();
    }

    // ===== Marketplace: listings + RFQs/bids =====
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid || isAdmin();
    }
    match /rfqs/{rfqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.buyerId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.buyerId == request.auth.uid || isAdmin();

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
        allow update: if isSignedIn() &&
          (resource.data.sellerId == request.auth.uid ||
           get(/databases/$(database)/documents/rfqs/$(rfqId)).data.buyerId == request.auth.uid);
        allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      }
    }

    // ===== Marketplace: vendor stores + products =====
    // BUG FIX: this collection had no rules at all before (default-deny),
    // so Market.jsx's "create your store" / StoreDetail.jsx's product list
    // could never actually work in production. Admin.jsx's analytics panel
    // also queried a `shops` collection that doesn't exist anywhere in the
    // app (this app uses `stores`) — fixed there too, see Admin.jsx.
    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid || isAdmin();

      match /products/{productId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
        allow update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // ===== Notifications (only the recipient can read/ack) =====
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        // Rate limit: ~2s gap per sender — stops notification-spam/harassment.
        (
          !exists(/databases/$(database)/documents/rateLimitsNotifications/$(request.auth.uid)) ||
          request.time > get(/databases/$(database)/documents/rateLimitsNotifications/$(request.auth.uid)).data.lastNotifAt + duration.value(2, 's')
        ) &&
        getAfter(/databases/$(database)/documents/rateLimitsNotifications/$(request.auth.uid)).data.lastNotifAt == request.time;
      allow delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    // ===== Presence (online / last seen) =====
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write, delete: if isOwner(userId);
    }

    // ===== Reports (users file, only admins read/manage) =====
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid &&
        // Rate limit: ~5s gap per reporter — stops report-flood abuse
        // while still allowing several genuine reports in a row.
        (
          !exists(/databases/$(database)/documents/rateLimitsReports/$(request.auth.uid)) ||
          request.time > get(/databases/$(database)/documents/rateLimitsReports/$(request.auth.uid)).data.lastReportAt + duration.value(5, 's')
        ) &&
        getAfter(/databases/$(database)/documents/rateLimitsReports/$(request.auth.uid)).data.lastReportAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
